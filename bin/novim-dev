#!/bin/bash
# novim-dev - One-release compatibility alias for the oh-my-code ohc launcher
# https://github.com/link2004/novim (custom derivative checkout)

set -euo pipefail

# 1. Ensure nvim exists
if ! command -v nvim &> /dev/null; then
  echo "Error: Neovim is not installed." >&2
  echo "Install it with: brew install neovim" >&2
  exit 1
fi

# 2. Setup paths (robustly resolve symlinks across macOS and Linux)
resolve_target() {
  local target="$1"
  if [[ "$target" != /* ]]; then
    if [[ "$target" == */* ]]; then
      target="$(pwd -P)/$target"
    else
      target="$(command -v "$target" || echo "$target")"
      [[ "$target" != /* ]] && target="$(pwd -P)/$target"
    fi
  fi

  if command -v realpath >/dev/null 2>&1; then
    realpath "$target"
  else
    while [[ -L "$target" ]]; do
      local link
      link="$(readlink "$target")"
      if [[ "$link" == /* ]]; then
        target="$link"
      else
        target="$(cd "$(dirname "$target")" && pwd -P)/$link"
      fi
    done
    echo "$target"
  fi
}

SCRIPT_PATH="$(resolve_target "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
NOVIM_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
NOVIM_CONFIG="$NOVIM_ROOT/config"

# Read version from VERSION file if present
BASE_VERSION="0.1.0"
if [[ -f "$NOVIM_ROOT/VERSION" ]]; then
  BASE_VERSION="$(tr -d '[:space:]' < "$NOVIM_ROOT/VERSION")"
fi
DEV_VERSION="${BASE_VERSION}-dev"

# 3. Handle flags
# Consume launcher-only controls before anything is forwarded to Neovim.
# --no-animation suppresses the startup splash below and is never forwarded.
NOVIM_ARGS=()
SPLASH_DISABLED=0
SPLASH_HEADLESS=0
FIRST_ARG=""
if [[ $# -gt 0 ]]; then
  for arg in "$@"; do
    if [[ "$arg" == "--no-animation" ]]; then
      SPLASH_DISABLED=1
    elif [[ "$arg" == "--headless" ]]; then
      SPLASH_HEADLESS=1
      NOVIM_ARGS+=("$arg")
    else
      if [[ -z "$FIRST_ARG" ]]; then
        FIRST_ARG="$arg"
      fi
      NOVIM_ARGS+=("$arg")
    fi
  done
fi

if [[ "$FIRST_ARG" == "--version" || "$FIRST_ARG" == "-v" ]]; then
  echo "novim-dev $DEV_VERSION (custom checkout)"
  echo "Note: novim-dev is a one-release compatibility alias for oh-my-code's public ohc command."
  echo "powered by $(nvim --version | head -1)"
  exit 0
fi

if [[ "$FIRST_ARG" == "--help" || "$FIRST_ARG" == "-h" ]]; then
  echo "novim-dev - Compatibility alias for the oh-my-code ohc launcher"
  echo ""
  echo "Usage: novim-dev [options] [file...]"
  echo ""
  echo "Options:"
  echo "  -v, --version    Show development version and Neovim engine"
  echo "  -h, --help       Show this help"
  echo ""
  echo "All other options and arguments are passed directly to Neovim."
  echo ""
  echo "Note: novim-dev is a one-release compatibility alias; the public"
  echo "command is ohc. Both commands share the same isolated configuration"
  echo "and runtime paths in this checkout."
  echo ""
  echo "Configuration root: $NOVIM_CONFIG"
  echo "Runtime state:      $NOVIM_ROOT/.dev-state"
  echo "Runtime data:       $NOVIM_ROOT/.dev-data"
  echo "Runtime cache:      $NOVIM_ROOT/.dev-cache"
  exit 0
fi

# 4. Export isolated runtime paths
export XDG_CONFIG_HOME="$NOVIM_CONFIG"
export XDG_DATA_HOME="$NOVIM_ROOT/.dev-data"
export XDG_STATE_HOME="$NOVIM_ROOT/.dev-state"
export XDG_CACHE_HOME="$NOVIM_ROOT/.dev-cache"

# Ensure isolated directories exist
mkdir -p "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"

# 5. Interactive startup splash (ADR-006: bounded to approximately one second)
# Same eligibility and disable behavior as the public ohc launcher: interactive
# TTY launch only. Help and version already exited above; --headless,
# --no-animation, OHC_NO_ANIMATION=1, and piped (non-TTY) output skip the
# splash entirely and start immediately.
render_splash() {
  local -a art=(
    "  ___   _      ____ "
    " / _ \ | |__  / ___|"
    "| | | || '_ \ | |    "
    "| |_| || | | || |___ "
    " \___/ |_| |_| \____|"
  )
  local -a colors=(24 30 37 44 51)
  local row i printed=0 total=${#art[@]}
  printf '\033[?25l'
  for ((row = 0; row < total; row++)); do
    if (( printed > 0 )); then
      printf '\033[%dA\r' "$printed"
    fi
    for ((i = 0; i <= row; i++)); do
      printf '\033[1;38;5;%dm%s\033[0m\n' "${colors[$i]}" "${art[$i]}"
    done
    printed=$((row + 1))
    sleep 0.12
  done
  printf '\033[%dA\r' "$printed"
  for ((i = 0; i < total; i++)); do
    printf '\033[1;38;5;%dm%s\033[0m\n' "${colors[$i]}" "${art[$i]}"
  done
  printf '\033[1;38;5;75moh-my-code | terminal-first code workbench\033[0m\n'
  printed=$((total + 1))
  sleep 0.20
  printf '\033[%dA\r' "$printed"
  for ((i = 0; i < total; i++)); do
    printf '\033[1;38;5;%dm%s\033[0m\n' "${colors[$i]}" "${art[$i]}"
  done
  printf '\033[1;38;5;75moh-my-code | terminal-first code workbench\033[0m\n'
  printf '\033[38;5;245mv%s\033[0m\n' "$DEV_VERSION"
  sleep 0.20
  printf '\033[?25h'
}

if [[ "$SPLASH_DISABLED" -eq 0 && "$SPLASH_HEADLESS" -eq 0 && "${OHC_NO_ANIMATION:-}" != "1" ]] && [[ -t 1 ]]; then
  render_splash
fi


# 6. Launch Neovim
exec nvim ${NOVIM_ARGS[@]+"${NOVIM_ARGS[@]}"}
