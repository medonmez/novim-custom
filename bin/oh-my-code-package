#!/bin/bash
# oh-my-code-package - Offline package and local install helper for oh-my-code
#
# The public, deterministic archive is oh-my-code-<VERSION>.tar.gz with a
# single oh-my-code-<VERSION> root. It stages the public bin/ohc launcher, the
# one-release bin/novim-dev compatibility launcher, the complete config/nvim
# tree, VERSION, LICENSE, and THIRD_PARTY_LICENSES.md.
#
# The helper never packages bin/novim, Git metadata, .dev-* runtime state,
# credentials, environment files, or special files. It never fetches Git data,
# calls a network service, or writes the installed `novim` release.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  oh-my-code-package package OUTPUT_ARCHIVE
  oh-my-code-package install ARCHIVE INSTALL_ROOT
  oh-my-code-package --help

Commands:
  package  Create a deterministic oh-my-code-<VERSION>.tar.gz from this checkout.
  install  Extract a validated oh-my-code archive into a new or empty
           explicitly named local root. This offline command never creates
           command links; the public networked installer (install.sh) owns
           ~/.local/share/oh-my-code and the ~/.local/bin links.

The helper only packages or installs oh-my-code. It never touches the
installed `novim` release or the user's normal Neovim configuration.
USAGE
}

resolve_target() {
  local target="$1"

  if [[ "$target" != /* ]]; then
    if [[ "$target" == */* ]]; then
      target="$(pwd -P)/$target"
    else
      target="$(command -v "$target" || echo "$target")"
      [[ "$target" != /* ]] && target="$(pwd -P)/$target"
    fi
  fi

  if command -v realpath >/dev/null 2>&1; then
    realpath "$target"
  else
    while [[ -L "$target" ]]; do
      local link
      link="$(readlink "$target")"
      if [[ "$link" == /* ]]; then
        target="$link"
      else
        target="$(cd "$(dirname "$target")" && pwd -P)/$link"
      fi
    done
    echo "$target"
  fi
}

SCRIPT_PATH="$(resolve_target "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
OHC_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"

STAGING_DIR=""
OUTPUT_TMP=""
cleanup() {
  if [[ -n "$OUTPUT_TMP" && -e "$OUTPUT_TMP" ]]; then
    rm -f "$OUTPUT_TMP"
  fi
  if [[ -n "$STAGING_DIR" && -d "$STAGING_DIR" ]]; then
    rm -rf "$STAGING_DIR"
  fi
}
trap cleanup EXIT

fail() {
  echo "Error: $*" >&2
  exit 1
}

read_version() {
  local version_file="$OHC_ROOT/VERSION"
  if [[ ! -f "$version_file" ]]; then
    fail "missing $version_file"
  fi

  VERSION="$(tr -d '[:space:]' < "$version_file")"
  if [[ -z "$VERSION" || "$VERSION" == *[!0-9A-Za-z._-]* ]]; then
    fail "VERSION must contain a simple package-safe identity."
  fi
}

validate_source_tree() {
  local relative
  for relative in \
    bin/ohc \
    bin/novim-dev \
    VERSION \
    LICENSE \
    THIRD_PARTY_LICENSES.md; do
    if [[ -L "$OHC_ROOT/$relative" || ! -f "$OHC_ROOT/$relative" ]]; then
      fail "required package input is not a regular file: $relative"
    fi
  done
  for relative in bin config; do
    if [[ -L "$OHC_ROOT/$relative" || ! -d "$OHC_ROOT/$relative" ]]; then
      fail "package input path is a link or not a real directory: $relative"
    fi
  done
  if [[ -L "$OHC_ROOT/config/nvim" || ! -d "$OHC_ROOT/config/nvim" ]]; then
    fail "required package input is not a real directory: config/nvim"
  fi

  # Every entry in the recursive config tree must be a regular non-symlink
  # file or a real directory. Links and special files are rejected before
  # any copy or archive byte is produced.
  local entry
  while IFS= read -r -d '' entry; do
    if [[ -L "$entry" ]]; then
      fail "package input tree contains a symlink: ${entry#"$OHC_ROOT"/}"
    fi
    if [[ ! -f "$entry" && ! -d "$entry" ]]; then
      fail "package input tree contains a special file: ${entry#"$OHC_ROOT"/}"
    fi
  done < <(find "$OHC_ROOT/config/nvim" -mindepth 1 -print0)
}

reject_private_or_runtime_entries() {
  local package_root="$1"
  local forbidden
  forbidden="$(find "$package_root" \( \
    -name '.git' -o \
    -name '.dev-*' -o \
    -name '.env' -o \
    -name '.env.*' -o \
    -iname '*credential*' -o \
    -iname '*secret*' -o \
    -iname '*.pem' -o \
    -iname '*.key' -o \
    -iname '*.sqlite*' -o \
    -iname '*.db' \
  \) -print -quit)"
  if [[ -n "$forbidden" ]]; then
    fail "refusing to package private or runtime entry: $forbidden"
  fi
}

create_package() {
  local output="$1"
  local output_dir
  local package_root
  local tar_file

  read_version
  validate_source_tree
  package_root="oh-my-code-$VERSION"

  if [[ -e "$output" || -L "$output" ]]; then
    fail "refusing to overwrite existing package: $output"
  fi
  output_dir="$(dirname "$output")"
  mkdir -p "$output_dir"

  STAGING_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ohmycode_package_stage_XXXXXX")"
  mkdir -p "$STAGING_DIR/$package_root/bin" "$STAGING_DIR/$package_root/config"
  cp "$OHC_ROOT/bin/ohc" "$STAGING_DIR/$package_root/bin/ohc"
  cp "$OHC_ROOT/bin/novim-dev" "$STAGING_DIR/$package_root/bin/novim-dev"
  cp -R "$OHC_ROOT/config/nvim" "$STAGING_DIR/$package_root/config/nvim"
  cp "$OHC_ROOT/VERSION" "$STAGING_DIR/$package_root/VERSION"
  cp "$OHC_ROOT/LICENSE" "$STAGING_DIR/$package_root/LICENSE"
  cp "$OHC_ROOT/THIRD_PARTY_LICENSES.md" "$STAGING_DIR/$package_root/THIRD_PARTY_LICENSES.md"
  chmod +x "$STAGING_DIR/$package_root/bin/ohc" "$STAGING_DIR/$package_root/bin/novim-dev"
  reject_private_or_runtime_entries "$STAGING_DIR/$package_root"

  # Normalize staging metadata so repeated packaging of the same checkout is
  # byte-identical on the local platform. The archive has no source metadata.
  # BSD tar treats the exact Unix epoch as an invalid ustar timestamp; use a
  # fixed, representable timestamp one day after it instead.
  find "$STAGING_DIR/$package_root" -exec touch -t 197001020000 {} \;
  tar_file="$STAGING_DIR/package.tar"
  tar -cf "$tar_file" --format=ustar -C "$STAGING_DIR" "$package_root"
  OUTPUT_TMP="$output_dir/.oh-my-code-package.$$"
  gzip -n -c "$tar_file" > "$OUTPUT_TMP"
  mv "$OUTPUT_TMP" "$output"
  OUTPUT_TMP=""

  echo "Package created: $output"
  echo "Identity: oh-my-code $VERSION"
}

# validate_archive ARCHIVE ROOT_NAME MANIFEST
# Shared fail-closed archive contract for the offline helper and the networked
# installer's structural checks. Rejects ambiguity instead of guessing.
validate_archive() {
  local archive="$1"
  local expected_root="$2"
  local manifest="$3"
  local first_entry
  local archive_root
  local entry

  if [[ ! -f "$archive" || -L "$archive" ]]; then
    fail "package archive is not a regular file: $archive"
  fi
  if ! tar -tzf "$archive" > "$manifest" 2>/dev/null; then
    fail "package archive is unreadable or malformed: $archive"
  fi
  if [[ ! -s "$manifest" ]]; then
    fail "package archive is empty: $archive"
  fi

  first_entry="$(sed -n '1p' "$manifest")"
  archive_root="${first_entry%%/*}"
  if [[ -z "$archive_root" || "$archive_root" != "$expected_root" ]]; then
    fail "package archive root is not $expected_root."
  fi

  if grep -Eq '(^|/)\.\.(/|$)' "$manifest"; then
    fail "package archive contains a path traversal entry."
  fi
  if grep -Eq '^/' "$manifest"; then
    fail "package archive contains an absolute-path entry."
  fi
  if grep -qF "\\" "$manifest"; then
    fail "package archive contains a backslash path entry."
  fi

  # Strict allowlist: one safe root plus exactly the public launcher, the
  # one-release compatibility launcher, the bundled config tree, and the
  # license/version set. Anything else is rejected.
  while IFS= read -r entry; do
    case "$entry" in
      "$expected_root/"|"$expected_root/bin/"|"$expected_root/config/"|\
"$expected_root/bin/ohc"|"$expected_root/bin/novim-dev"|\
"$expected_root/VERSION"|"$expected_root/LICENSE"|\
"$expected_root/THIRD_PARTY_LICENSES.md") ;;
      "$expected_root"/config/nvim|"$expected_root"/config/nvim/*) ;;
      *)
        fail "package archive contains an entry outside the allowlist: $entry"
        ;;
    esac
  done < "$manifest"

  for required in \
    "$expected_root/bin/ohc" \
    "$expected_root/bin/novim-dev" \
    "$expected_root/config/nvim/" \
    "$expected_root/config/nvim/init.lua" \
    "$expected_root/VERSION" \
    "$expected_root/LICENSE" \
    "$expected_root/THIRD_PARTY_LICENSES.md"; do
    if ! grep -Fqx "$required" "$manifest"; then
      fail "package archive is missing required entry: $required"
    fi
  done

  if grep -Fqx "$expected_root/bin/novim" "$manifest"; then
    fail "package archive contains the installed-release launcher."
  fi
  if grep -Eq '(^|/)\.git(/|$)|(^|/)\.dev-[^/]*(/|$)' "$manifest"; then
    fail "package archive contains Git metadata or runtime state."
  fi
  if grep -Eiq '(^|/)(\.env([.]|$)|.*credential.*|.*secret.*|.*\.(pem|key|sqlite|db))(/|$)' "$manifest"; then
    fail "package archive contains a private or credential-like entry."
  fi
  if tar -tvzf "$archive" 2>/dev/null | grep -Eq '^[[:space:]]*[bchlps]'; then
    fail "package archive contains a link or special file."
  fi
}

install_package() {
  local archive="$1"
  local install_root="$2"
  local manifest
  local expected_root
  local staged_version
  local target_created=0

  read_version
  expected_root="oh-my-code-$VERSION"

  if [[ -L "$install_root" ]]; then
    fail "refusing to install through a symlink: $install_root"
  fi
  if [[ -e "$install_root" && ! -d "$install_root" ]]; then
    fail "install root is not a directory: $install_root"
  fi

  STAGING_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ohmycode_install_check_XXXXXX")"
  manifest="$STAGING_DIR/manifest.txt"

  # Validate completely before the target is touched. A failed validation
  # leaves the target and temporary state unchanged.
  validate_archive "$archive" "$expected_root" "$manifest"

  # Fail-closed VERSION identity: the archived VERSION content must agree
  # with the expected oh-my-code-$VERSION root identity before the target
  # is touched in any way.
  if ! tar -xzf "$archive" -C "$STAGING_DIR" "$expected_root/VERSION" >/dev/null 2>&1; then
    fail "package archive VERSION is unreadable: $archive"
  fi
  staged_version="$(tr -d '[:space:]' < "$STAGING_DIR/$expected_root/VERSION" 2>/dev/null || true)"
  if [[ "$staged_version" != "$VERSION" ]]; then
    fail "package archive VERSION (${staged_version:-missing}) does not match the expected $expected_root identity."
  fi
  if [[ -d "$install_root" ]]; then
    local entries=()
    shopt -s nullglob dotglob
    entries=("$install_root"/*)
    shopt -u nullglob dotglob
    if (( ${#entries[@]} > 0 )); then
      fail "install root must be new or empty: $install_root"
    fi
  else
    mkdir -p "$install_root"
    target_created=1
  fi

  if ! tar -xzf "$archive" -C "$install_root" --strip-components=1; then
    if (( target_created == 1 )); then
      rm -rf "$install_root"
    fi
    fail "failed to extract package: $archive"
  fi
  chmod +x "$install_root/bin/ohc" "$install_root/bin/novim-dev"

  echo "Package installed: $install_root"
  echo "Public launcher:   $install_root/bin/ohc"
  echo "Alias launcher:    $install_root/bin/novim-dev"
}

main() {
  local command="${1:-}"
  case "$command" in
    package)
      if [[ "$#" -ne 2 ]]; then
        usage >&2
        exit 2
      fi
      create_package "$2"
      ;;
    install)
      if [[ "$#" -ne 3 ]]; then
        usage >&2
        exit 2
      fi
      install_package "$2" "$3"
      ;;
    --help|-h|"")
      usage
      ;;
    *)
      echo "Error: unknown command: $command" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
